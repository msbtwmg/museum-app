<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ResultActivity"
 >

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorPrimary"
        android:theme="@style/ThemeOverlay.AppCompat.Light"
        android:titleTextColor="@android:color/white"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:title="Search Results"
        app:titleTextColor="@color/onPrimaryColor" />

    <androidx.appcompat.widget.SearchView
        android:id="@+id/againSearchView"
        android:layout_marginTop="10dp"
        android:layout_marginStart="6dp"
        android:elevation="10dp"
        android:layout_width="0dp"
        android:layout_height="55dp"
        android:background="@color/onSecondaryColor"
        android:queryHint="Search artworks, artists, or keywords"
        app:layout_constraintEnd_toStartOf="@id/openFilterButtonAgain"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar" />

    <ImageButton
        android:id="@+id/openFilterButtonAgain"
        android:layout_width="55dp"
        android:layout_height="55dp"
        android:elevation="10dp"
        android:layout_marginEnd="6dp"
        android:background="@color/onSecondaryColor"
        android:contentDescription="@string/search_filter"
        android:padding="10dp"
        android:src="@drawable/filter_small"
        app:layout_constraintTop_toTopOf="@id/againSearchView"
        app:layout_constraintBottom_toBottomOf="@id/againSearchView"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/artworkRecyclerView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:padding="5dp"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/againSearchView"
        app:layout_constraintBottom_toTopOf="@id/openLandingButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/openLandingButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="5dp"
        android:text="@string/go_back"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/artworkRecyclerView" />




</androidx.constraintlayout.widget.ConstraintLayout>
